# Tailscale Serve strips client-supplied identity headers before injecting the
# authenticated user's login. NetBird mode binds its peer address directly and
# relies on NetBird ACLs plus the Harness browser cookie for access control.
{
	admin off
	auto_https off
}

:{$DSH_PUBLIC_PORT} {
	bind {$DSH_BIND_ADDRESS}
	encode zstd gzip

	@versioned_bundle {
		path_regexp versionedBundle ^/plugins/.+/client\.js$
		query rev=*
	}
	header @versioned_bundle >Cache-Control "public, max-age=31536000, immutable"

	# Native service mode keeps the launch token in Caddy's environment and uses
	# the Serve-injected owner identity to establish a browser session.
	@netbird_index_without_cookie {
		expression `{env.DSH_VPN_PROVIDER} == "netbird"`
		path /
		not header_regexp Cookie dsh-auth-
	}

	handle @netbird_index_without_cookie {
		rewrite * /?token={$DSH_BROWSER_LAUNCH_TOKEN}
		reverse_proxy 127.0.0.1:{$DSH_BACKEND_PORT} {
			header_up Host {http.request.host}
		}
	}

	@owner_index_without_cookie {
		expression `{env.DSH_BROWSER_LAUNCH_TOKEN} != ""`
		header Tailscale-User-Login {$TAILSCALE_OWNER}
		path /
		not header_regexp Cookie dsh-auth-
	}

	handle @owner_index_without_cookie {
		rewrite * /?token={$DSH_BROWSER_LAUNCH_TOKEN}
		reverse_proxy 127.0.0.1:{$DSH_BACKEND_PORT} {
			header_up Host {http.request.host}
		}
	}

	@owner_task_board {
		header Tailscale-User-Login {$TAILSCALE_OWNER}
		path /api/task-board/*
	}

	handle @owner_task_board {
		reverse_proxy 127.0.0.1:{$DSH_BACKEND_PORT} {
			header_up Host {http.request.host}
			header_up X-Dsh-Task-Board-Proxy-Token {$DSH_TASK_BOARD_PROXY_TOKEN}
		}
	}

	# The complete Host API is owner-only. Matching the namespace instead of an
	# endpoint allowlist keeps newly installed tools and plugin routes reachable.
	@owner_api {
		header Tailscale-User-Login {$TAILSCALE_OWNER}
		path /api /api/*
	}

	handle @owner_api {
		reverse_proxy 127.0.0.1:{$DSH_BACKEND_PORT} {
			header_up Host {http.request.host}
			header_up -X-Dsh-Task-Board-Proxy-Token
		}
	}

	@netbird_api {
		expression `{env.DSH_VPN_PROVIDER} == "netbird"`
		path /api /api/*
	}

	handle @netbird_api {
		reverse_proxy 127.0.0.1:{$DSH_BACKEND_PORT} {
			header_up Host {http.request.host}
			header_up -X-Dsh-Task-Board-Proxy-Token
		}
	}

	@api {
		path /api /api/*
	}
	handle @api {
		respond 403
	}

	# Static assets and application routes remain available to the tailnet; the
	# Host still requires its authority-bound browser cookie for protected data.
	handle {
		reverse_proxy 127.0.0.1:{$DSH_BACKEND_PORT} {
			header_up Host {http.request.host}
			header_up -X-Dsh-Task-Board-Proxy-Token
		}
	}
}
